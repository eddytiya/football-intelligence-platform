# PostgreSQL connection (use real values only in backend/.env)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=football_intelligence
DB_USER=postgres
DB_PASSWORD=change_me
# Set to "require" for managed Postgres (Neon, Supabase, etc.); leave blank locally.
DB_SSLMODE=

# https://www.football-data.org/ API configuration
FOOTBALL_API_KEY=change_me
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4

REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=2
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:5173

# Refresh recent match scores from football-data.org every 10 minutes.
LIVE_SCORE_SYNC_ENABLED=true
LIVE_SCORE_SYNC_INTERVAL_MINUTES=10

# Import newly announced fixtures once daily, up to 90 days ahead.
FUTURE_FIXTURE_SYNC_DAYS=90
FUTURE_FIXTURE_SYNC_INTERVAL_HOURS=24

# Refresh validated provider CSV history daily and reload prediction states.
PREDICTION_HISTORY_SYNC_ENABLED=true
PREDICTION_HISTORY_SYNC_INTERVAL_HOURS=24

# Watchlist notifications. In-app notifications work with no setup below.
# Email stays off (NOTIFICATIONS_EMAIL_ENABLED=false) until you fill in an
# SMTP provider (e.g. Gmail app password, SendGrid, Resend) and flip it on.
WATCHLIST_NOTIFICATION_INTERVAL_MINUTES=5
NOTIFICATIONS_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# News works out of the box with no signup (a free, keyless Google News
# search feed). Optionally set NEWS_API_KEY (https://newsapi.org, free tier)
# to upgrade to richer headlines with article images.
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2
# Optional administrator bootstrap. Set both server-side; never expose in Vite.
ADMIN_EMAIL=
ADMIN_PASSWORD=
